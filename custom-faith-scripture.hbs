{{!< default}}
{{#contentFor "moHead"}}
<title>Scripture Index | The Faith Received</title>
<meta name="description" content="Find where the creeds, confessions, and classic works of the Christian tradition cite any passage of Scripture." />
<meta property="og:title" content="Scripture Index | The Faith Received" />
<meta property="og:description" content="Find where the creeds, confessions, and classic works of the Christian tradition cite any passage of Scripture." />
<meta name="twitter:title" content="Scripture Index | The Faith Received" />
<meta name="twitter:description" content="Find where the creeds, confessions, and classic works of the Christian tradition cite any passage of Scripture." />
{{/contentFor}}
{{!-- /the-faith-received/scripture/ — Scripture index. Lists every
     biblical book and the references found across the documents in
     the library. Source data built into
     assets/data/faith-received/scripture-index.json by the build
     script (which copies it from the heidelberg repo). Body markup
     lives in _scripture-body.hbs so the home Scripture tab and this
     routed page render identical content. --}}

<main class="faith-received faith-feature">

  <section class="bhero bhero--tool">
  <div class="bhero-inner container">
    <p class="bhero-kicker"><a href="/the-faith-received/">The Faith Received</a> <span aria-hidden="true">&middot;</span> <a href="/the-faith-received/scripture/">Scripture Index</a></p>
    <h1>Scripture Index</h1>
    <p class="bhero-sub">Every biblical passage that the historic creeds, catechisms, and library cite or expound. Pick a book; jump to the reference.</p>
  </div>
</section>


  {{!-- data-faith-section is the mount faith-indexes.js looks for.
        Without it the script returned at its first line, so this page
        rendered "Loading scripture index…" and never resolved. --}}
  <section class="bband faith-feature-body" data-faith-section="scripture">
    <div class="container">
      {{> "faith-received/_scripture-body"}}
    </div>
  </section>

{{> "faith-received/_beta-band"}}
</main>

{{!-- mo-tfr-library, read from here by both scripts below rather than
     written into either of them. Same tag, same value, as every other
     Faith Received page. --}}
<meta name="tfr-library-base" content="https://mo-tfr-library.mo-podcast-feed.workers.dev" />
{{!-- The index is merged from every collection at read time, so the
     corpus registry has to be present before faith-indexes.js runs. --}}
<script src="{{asset "js/faith-corpora.js"}}"></script>
<script src="{{asset "js/faith-century.js"}}"></script>
<script src="{{asset "js/faith-received.js"}}"></script>
{{!-- The generated index: every citation found by walking the text
     itself, rather than the partial indexes the source sites ship.
     Too large for the theme zip, so it lives in our own R2 bucket and
     this points at it. Set the tag and the shipped source indexes stop
     being used; unset it, or let the fetch fail, and they come back. --}}
<meta name="tfr-scripture-index" content="https://mo-tfr-library.mo-podcast-feed.workers.dev/v1/index/scripture-books.json" />
<script src="{{asset "js/faith-indexes.js"}}"></script>
{{!-- The library-wide citation totals. Still its own fetch and its own
     panel: it draws the lede, the canon density strip, the tradition
     chips and the jump control, and it hands the per-book citation
     figures to faith-indexes.js, which paints them into the book rows
     rather than drawing a second list of the same books above them.
     One way, one object (window.MOScriptureTotals) plus an event, so
     either script can finish first and a fault in this one costs the
     accordion its bars and nothing else. See the file's own header for
     what the figure counts and why it differs from the count inside an
     opened book. --}}
<script src="{{asset "js/faith-scripture-totals.js"}}"></script>
