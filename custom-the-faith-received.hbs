<section class="lp-band lp-band--rule" id="collection">
  <div class="container">
    <p class="lp-num">In the collection</p>
    <div class="faith-card-grid">
      <a class="faith-card" href="/the-faith-received/reader/?c=mo&amp;w=apostles-creed">
        <p class="faith-card-date">The whole church</p><p class="faith-card-era">c. 2nd–4th Century</p>
        <h3 class="faith-card-title"><em>The Apostles’ Creed</em></h3>
        <p class="faith-card-desc">The ancient baptismal confession of the Christian faith in three articles.</p>
        <span class="faith-card-link">Read <span class="faith-card-arrow">&rarr;</span></span>
      </a>
      <a class="faith-card" href="/the-faith-received/reader/?c=mo&amp;w=nicene-creed">
        <p class="faith-card-date">The whole church</p><p class="faith-card-era">325 / 381 AD</p>
        <h3 class="faith-card-title"><em>The Nicene Creed</em></h3>
        <p class="faith-card-desc">The definitive creed of the universal church on the Trinity and incarnation.</p>
        <span class="faith-card-link">Read <span class="faith-card-arrow">&rarr;</span></span>
      </a>
      <a class="faith-card" href="/the-faith-received/reader/?c=mo&amp;w=heidelberg">
        <p class="faith-card-date">Reformed</p><p class="faith-card-era">1563</p>
        <h3 class="faith-card-title"><em>The Heidelberg Catechism</em></h3>
        <p class="faith-card-desc">129 questions and answers for the Christian life, organized into 52 Lord’s Days.</p>
        <span class="faith-card-link">Read <span class="faith-card-arrow">&rarr;</span></span>
      </a>
      <a class="faith-card" href="/the-faith-received/reader/?c=mo&amp;w=westminster-shorter">
        <p class="faith-card-date">Reformed</p><p class="faith-card-era">1647</p>
        <h3 class="faith-card-title"><em>Westminster Shorter Catechism</em></h3>
        <p class="faith-card-desc">107 questions and answers teaching the essentials of Reformed Christian doctrine.</p>
        <span class="faith-card-link">Read <span class="faith-card-arrow">&rarr;</span></span>
      </a>
      <a class="faith-card" href="/the-faith-received/reader/?c=mo&amp;w=didache">
        <p class="faith-card-date">The early church</p><p class="faith-card-era">c. 50–120 AD</p>
        <h3 class="faith-card-title"><em>The Didache</em></h3>
        <p class="faith-card-desc">16 chapters of early Christian teaching on ethics, worship, and church life.</p>
        <span class="faith-card-link">Read <span class="faith-card-arrow">&rarr;</span></span>
      </a>
      <a class="faith-card" href="/the-faith-received/reader/?c=mo&amp;w=athanasius-incarnation">
        <p class="faith-card-date">Athanasius</p><p class="faith-card-era">c. 318 AD</p>
        <h3 class="faith-card-title"><em>On the Incarnation</em></h3>
        <p class="faith-card-desc">Athanasius’ classic defense of the Incarnation, why the eternal Word took flesh to restore fallen humanity and conquer death.</p>
        <span class="faith-card-link">Read <span class="faith-card-arrow">&rarr;</span></span>
      </a>
      <a class="faith-card" href="/the-faith-received/reader/?c=mo&amp;w=augustine-confessions">
        <p class="faith-card-date">Augustine of Hippo</p><p class="faith-card-era">c. 397–400 AD</p>
        <h3 class="faith-card-title"><em>Confessions</em></h3>
        <p class="faith-card-desc">Augustine’s autobiographical meditation on sin, grace, memory, and time. The first great Western autobiography.</p>
        <span class="faith-card-link">Read <span class="faith-card-arrow">&rarr;</span></span>
      </a>
      <a class="faith-card" href="/the-faith-received/reader/?c=mo&amp;w=imitation-of-christ">
        <p class="faith-card-date">Thomas &agrave; Kempis</p><p class="faith-card-era">c. 1418–1427</p>
        <h3 class="faith-card-title"><em>The Imitation of Christ</em></h3>
        <p class="faith-card-desc">The most widely read devotional work after the Bible, a guide to the interior life of prayer, humility, and union with God.</p>
        <span class="faith-card-link">Read <span class="faith-card-arrow">&rarr;</span></span>
      </a>
      <a class="faith-card" href="/the-faith-received/reader/?c=mo&amp;w=edwards-resolutions">
        <p class="faith-card-date">Jonathan Edwards</p><p class="faith-card-era">1722–1723</p>
        <h3 class="faith-card-title"><em>Resolutions</em></h3>
        <p class="faith-card-desc">70 personal resolutions for holy living, written between ages 18 and 20.</p>
        <span class="faith-card-link">Read <span class="faith-card-arrow">&rarr;</span></span>
      </a>
      <a class="faith-card" href="/the-faith-received/reader/?c=mo&amp;w=calvin-institutes">
        <p class="faith-card-date">John Calvin</p><p class="faith-card-era">1536 / 1559</p>
        <h3 class="faith-card-title"><em>Institutes of the Christian Religion</em></h3>
        <p class="faith-card-desc">The foundational work of Reformed systematic theology, covering God, Scripture, Christ, salvation, and the Church across four books.</p>
        <span class="faith-card-link">Read <span class="faith-card-arrow">&rarr;</span></span>
      </a>
      <a class="faith-card" href="/the-faith-received/read/?w=polanus-amandus-polanus-syntagma-theologiae-christianae-liber-i-de-the">
        <p class="faith-card-date">Amandus Polanus</p><p class="faith-card-era">1615</p>
        <h3 class="faith-card-title"><em>Syntagma Theologiae Christianae</em></h3>
        <p class="faith-card-desc">Polanus’s systematic account of Reformed theology. Begin with Book I, on Scripture and the foundations of theology.</p>
        <span class="faith-card-link">Read <span class="faith-card-arrow">&rarr;</span></span>
      </a>
      <a class="faith-card" href="/the-faith-received/reader/?c=mo&amp;w=belgic">
        <p class="faith-card-date">Reformed</p><p class="faith-card-era">1561</p>
        <h3 class="faith-card-title"><em>The Belgic Confession</em></h3>
        <p class="faith-card-desc">37 articles of faith confessing the core doctrines of the Christian faith.</p>
        <span class="faith-card-link">Read <span class="faith-card-arrow">&rarr;</span></span>
      </a>
    </div>
    <p class="lp-more"><a class="lp-more-link" href="/the-faith-received/all-works/?collection=all">Browse the whole library <span class="faith-card-arrow">&rarr;</span></a></p>
  </div>
</section>

