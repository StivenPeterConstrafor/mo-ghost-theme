     BEFORE site.min.js (FRONTEND §6.18), so nothing bundled can be
     assumed here; the only bundle global this page touches is
     window.MOSafeHref, which ships in boot.min.js in <head>. --}}
<script src="{{asset "js/lib/faith-desk-store.js"}}"></script>
<script src="{{asset "js/page/faith-compare.js"}}"></script>
