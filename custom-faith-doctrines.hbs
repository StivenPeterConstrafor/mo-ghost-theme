{{!< default}}
{{#contentFor "moHead"}}
<title>Every Doctrine | The Faith Received</title>
<meta name="description" content="Every doctrinal topic the mo-tfr knowledge graph tracks across the library &mdash; who wrote on it most, and what they said, from the Fathers to the Post-Reformation divines." />
<meta property="og:title" content="Every Doctrine | The Faith Received" />
<meta property="og:description" content="Every doctrinal topic the mo-tfr knowledge graph tracks across the library, ranked by how much the tradition wrote on it." />
<meta name="twitter:title" content="Every Doctrine | The Faith Received" />
<meta name="twitter:description" content="Every doctrinal topic the mo-tfr knowledge graph tracks across the library, ranked by how much the tradition wrote on it." />
{{/contentFor}}
{{!-- /the-faith-received/doctrines/[?s=<slug>] — the full ~190-topic
     layer from v1/mine/topic2-all/, the granular layer underneath the
     13 curated topic pages (see TOPIC2_MAP in
     assets/js/faith-topic-synthesis.js for which ~17 of these are
     already surfaced there). One route, two states, same pattern as
     /the-faith-received/author/?a=: no ?s= is the index — every topic,
     sorted by how much the tradition wrote on it, filterable by name;
     ?s=<slug> is one topic's author strip + chronological positions,
     rendered by the same window.MOTopicSynth.renderTopic2Block that
     the curated pages use. --}}

<main class="faith-received faith-doctrines-page">

  <section class="bhero bhero--tool">
    <div class="bhero-inner container">
      <p class="bhero-kicker"><a href="/the-faith-received/">The Faith Received</a> <span aria-hidden="true">&middot;</span> <a href="/the-faith-received/doctrines/">Doctrines</a></p>
      <h1 data-faith-doctrines-title>Every doctrine</h1>
      <p class="bhero-sub" data-faith-doctrines-sub>Every topic the library's knowledge graph tracks, ranked by how much the tradition wrote on it. Thirteen of these have their own curated reading page; the rest are here.</p>
    </div>
  </section>

  <section class="bband faith-feature-body">
    <div class="container" data-faith-doctrines>
      <p class="faith-doctrines-loading">Loading&hellip;</p>
    </div>
  </section>

  {{!-- Positions: one writer at a time on this doctrine, the whole of
       what the library holds rather than the sample the block above
       draws from. Present on both states of this route and hides itself
       on the index one, where there is no ?s= and so no doctrine for it
       to be about. Nothing is fetched until it is scrolled to. --}}
  <section class="bband faith-positions-band"
           data-faith-positions
           data-positions-topic-param="s"></section>

</main>

{{!-- The one data host this page talks to. faith-doctrines.js and
     faith-topic-synthesis.js each carry their own copy of this origin
     in JS; faith-positions.js reads it from here, which is the
     convention the rest of The Faith Received follows. --}}
<meta name="tfr-library-base" content="https://mo-tfr-library.mo-podcast-feed.workers.dev" />
<script src="{{asset "js/faith-topic-synthesis.js"}}"></script>
<script src="{{asset "js/faith-doctrines.js"}}"></script>
<script src="{{asset "js/faith-positions.js"}}"></script>
