{{!< default}}
{{#contentFor "moHead"}}<title>{{meta_title}}</title>{{/contentFor}}

{{!-- tag.hbs — two layouts off one template.
     `{{#tag}}` scopes to tag properties (slug, name, description,
     feature_image). `posts` is the top-level paginated post list
     for this tag archive and must be iterated OUTSIDE the tag
     block. --}}

<div class="tag-page" data-tag-slug="{{#tag}}{{slug}}{{/tag}}">

    {{#tag}}
    {{!-- SEO audit 2026-09-22 (M3): both headers used to render on every
         tag page and CSS hid one, so all 998 tag pages shipped two h1s.
         The same condition the CSS used (slug starts with "author-") now
         decides which header is built at all. The CSS swap stays, so the
         classes keep working if this ever renders both again. --}}
    {{#match slug "~^" "author-"}}
    <header class="contributor-header tag-page-contributor">
        <div class="contributor-header-inner">
            <div class="contributor-portrait" aria-hidden="true">
                {{#if feature_image}}
                    <img src="{{img_url feature_image size="m"}}" alt="{{name}}" loading="eager" width="180" height="180" />
                {{else}}
                    <span class="contributor-initials">{{name}}</span>
                {{/if}}
            </div>
            <div class="contributor-header-body">
                <p class="eyebrow">Contributor</p>
                <h1><em>{{name}}</em></h1>
                {{#if description}}
                    <p class="contributor-bio">{{description}}</p>
                {{/if}}
            </div>
        </div>
    </header>
    {{else}}
    <header class="archive-header tag-page-archive">
        <div class="archive-header-inner">
            <p class="eyebrow">Filed under</p>
            <h1><em>{{name}}</em></h1>
            {{#if description}}
                <p class="archive-description">{{description}}</p>
            {{/if}}
        </div>
    </header>
    {{/match}}
    {{/tag}}

    <section class="archive-body">
        <div class="container">
            <div class="week-grid">
                {{#foreach posts}}
                    {{> "post-entry" showYear=true}}
                {{/foreach}}
            </div>

            {{#if pagination.pages}}
                {{#if pagination.total}}
                    {{#if pagination.prev}}
                        {{#unless pagination.next}}
                            <nav class="pagination" aria-label="Pagination">
                                <a href="{{page_url pagination.prev}}">&larr; Previous</a>
                                <span class="pagination-spacer"></span>
                                <span class="pagination-current">Page {{pagination.page}} of {{pagination.pages}}</span>
                                <span class="pagination-spacer"></span>
                                <span></span>
                            </nav>
                        {{/unless}}
                    {{/if}}
                    {{#if pagination.next}}
                        <nav class="pagination" aria-label="Pagination">
                            {{#if pagination.prev}}
                                <a href="{{page_url pagination.prev}}">&larr; Previous</a>
                            {{else}}
                                <span></span>
                            {{/if}}
                            <span class="pagination-spacer"></span>
                            <span class="pagination-current">Page {{pagination.page}} of {{pagination.pages}}</span>
                            <span class="pagination-spacer"></span>
                            <a href="{{page_url pagination.next}}">Next &rarr;</a>
                        </nav>
                    {{/if}}
                {{/if}}
            {{/if}}
        </div>
    </section>

</div>
