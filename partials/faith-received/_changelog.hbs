{{!-- The changelog (Ian, 2026-09-30): every change made to a work or to
      all works, requested or not, and the open reports the hourly health
      check has summarized. Its own tab on the About page; filled by
      assets/js/faith-changelog.js from mo-forms GET /tfr-changes. --}}
<section class="faith-tp-list-wrap faith-tp-log-wrap" data-faith-changelog>
  <div class="faith-tp-list faith-tp-log-box">
    <div class="faith-tp-list-head faith-tp-log-head">
      <span class="faith-tp-list-title">Changelog</span>
      <span class="faith-tp-list-count" data-cl-count>Loading&hellip;</span>
    </div>
    <div class="faith-tp-list-body">
      <div class="faith-tp-log-bar">
        <div class="faith-tp-log-toggle" role="group" aria-label="Show">
          <button type="button" data-cl-view="open" aria-selected="false">Open reports <span data-cl-n></span></button>
          <button type="button" data-cl-view="closed" aria-selected="true">Closed reports <span data-cl-n></span></button>
        </div>
        <label class="faith-tp-log-sort"><span>Sort</span>
          <select data-cl-sort>
            <option value="new">Newest</option>
            <option value="old">Oldest</option>
            <option value="up">Most thumbs up</option>
            <option value="down">Most thumbs down</option>
          </select>
        </label>
      </div>
      <ol class="faith-tp-log" data-cl-list></ol>
      <div class="faith-tp-log-pager" data-cl-pager hidden>
        <button type="button" data-cl-prev>Previous</button>
        <span data-cl-at></span>
        <button type="button" data-cl-next>Next</button>
      </div>
    </div>
  </div>
</section>
