{{!< default}}
{{!-- The TFR rail, first on the page and pinned under the masthead as on the reader (Ian, 2026-09-23). --}}
{{> "faith-received/_tfr-rail"}}
{{#contentFor "moHead"}}
<title>Commentary decks | The Faith Received | Mere Orthodoxy</title>
<meta name="description" content="Lombard's Sentences, Aquinas's Summa, the Reformed disputations, Vitringa's aphorisms, Gerhard's loci, the Decretals, Gratian's Decretum and the systems of theology, place by place: the text and its commentators, or the systems, read side by side, each with his own questions and articles and their pages." />
<link rel=preconnect href="https://fonts.googleapis.com"><link rel=preconnect href="https://fonts.gstatic.com" crossorigin>
<link rel=stylesheet href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Source+Serif+Pro:ital,wght@0,400;0,600;1,400&display=swap">
<style>
.tfr-tool{--bg:#FFFFFF;--fg:#1C1C1A;--muted:#5A5A56;--border:#D8D8D3;--card-bg:#FFFFFF;--highlight:#EFEFEA;--card:#FFFFFF;--hl:#E7E7E2;--tint:#F6F6F3;
  --affirms:#3F6B4E;--denies:#A8462B;--s-thomist:#2F5E99;--s-scotist:#7A4E9B;--s-nominalist:#A87420;--s-jesuit:#1F7A80;--s-augustinian:#94506E;--s-other:#7A7A76;
  --font-display:'EB Garamond',Georgia,serif;--font-body:'Source Serif Pro',Georgia,serif;--sans:'Source Serif Pro',Georgia,serif;
  --sticky:.75rem;--ease:cubic-bezier(.22,1,.36,1)}
.tfr-tool *{box-sizing:border-box}
.tfr-tool{margin:0;background:var(--bg);color:var(--fg);font:16px/1.62 var(--font-body);-webkit-font-smoothing:antialiased}
.tfr-tool a{color:var(--fg)}
.tfr-tool button,.tfr-tool select,.tfr-tool input{font:inherit;color:inherit}
.tfr-tool .top{background:var(--bg);padding:1rem 1.4rem .8rem;display:flex;align-items:baseline;gap:.9rem;flex-wrap:wrap;border-bottom:1px solid var(--border)}
.tfr-tool .top .wm{font:500 1.25rem/1 var(--font-display);text-decoration:none}
.tfr-tool .top .sub{font:italic 1rem/1 var(--font-display);color:var(--muted)}
.tfr-tool .wrap{max-width:96rem;margin:0 auto;padding:1.4rem 1.2rem 3rem}
.tfr-tool h1{font:500 2rem/1.2 var(--font-display);margin:.1rem 0 .4rem;text-wrap:balance}
.tfr-tool .lede{max-width:72ch;color:var(--muted);margin:0 0 1.1rem;text-wrap:pretty}
.tfr-tool .tabs{display:flex;flex-wrap:wrap;gap:0 1.6rem;border-bottom:1px solid var(--border);margin:0 0 .9rem}
.tfr-tool .tabs button{appearance:none;border:0;background:none;padding:.6rem 0;margin-bottom:-1px;font:500 1.25rem/1.2 var(--font-display);color:var(--muted);border-bottom:2px solid transparent;cursor:pointer}
.tfr-tool .tabs button[aria-selected="true"]{color:var(--fg);border-bottom-color:var(--fg)}
.tfr-tool .bar{display:flex;flex-wrap:wrap;align-items:center;gap:.6rem 1rem;margin:0 0 .8rem}
.tfr-tool .parts{display:flex;gap:.4rem;flex-wrap:wrap;margin-right:auto}
.tfr-tool .chip{border:1px solid var(--border);background:var(--card-bg);padding:.38rem .8rem;border-radius:3px;font:600 .875rem/1.2 var(--sans);cursor:pointer}
.tfr-tool .chip small{font-weight:400;color:var(--muted);margin-left:.15rem}
.tfr-tool .chip[aria-pressed="true"]{background:var(--fg);border-color:var(--fg);color:var(--bg)}
.tfr-tool .chip[aria-pressed="true"] small{color:var(--bg)}
.tfr-tool .seg{display:inline-flex;border:1px solid var(--border);border-radius:3px;overflow:hidden;background:var(--card-bg)}
.tfr-tool .seg button{appearance:none;border:0;background:none;padding:.38rem .85rem;font:600 .875rem/1.2 var(--sans);color:var(--muted);cursor:pointer;min-height:2.25rem}
.tfr-tool .seg button+button{border-left:1px solid var(--border)}
.tfr-tool .seg button[aria-pressed="true"]{background:var(--fg);color:var(--bg)}
.tfr-tool .stepper{display:flex;align-items:center;gap:.35rem}
.tfr-tool .stepper button{border:1px solid var(--border);background:var(--card-bg);border-radius:8px;padding:.45rem .8rem;cursor:pointer;font:500 1rem/1.2 var(--font-display);min-height:2.25rem}
.tfr-tool .stepper button:disabled{opacity:.4;cursor:default}
.tfr-tool .stepper #pick{min-width:12rem;text-align:center}
.tfr-tool .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(3.4rem,1fr));gap:.35rem;margin:0 0 1rem;padding:.8rem;border:1px solid var(--border);border-radius:10px;background:var(--card-bg)}
.tfr-tool .grid[hidden]{display:none}
.tfr-tool .grid button{display:flex;flex-direction:column;align-items:center;gap:.1rem;padding:.4rem .2rem;border:1px solid var(--border);background:var(--bg);border-radius:6px;cursor:pointer;font:500 1rem/1 var(--font-display)}
.tfr-tool .grid button small{font:600 .75rem/1 var(--sans);color:var(--muted);font-variant-numeric:tabular-nums}
.tfr-tool .grid button[aria-pressed="true"]{background:var(--fg);color:var(--bg);border-color:var(--fg)}
.tfr-tool .grid button[aria-pressed="true"] small{color:var(--bg)}
.tfr-tool .grid button.empty{opacity:.45}
.tfr-tool :is(.tabs button,.tfr-tool .chip,.tfr-tool .seg button,.tfr-tool .grid button,.tfr-tool .stepper button,.tfr-tool .c-read,.tfr-tool .toc button,.tfr-tool .back,.tfr-tool .pane select,.tfr-tool .find,.tfr-tool .absent>summary,.tfr-tool .toc summary,.tfr-tool .near a,.tfr-tool .abs-note a):focus-visible{outline:2px solid var(--fg);outline-offset:2px}
.tfr-tool .switch{display:none}
.tfr-tool .desk{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:1rem;align-items:start}
.tfr-tool .pane{position:sticky;top:var(--sticky);height:calc(100vh - var(--sticky) - 1rem);height:calc(100dvh - var(--sticky) - 1rem);display:flex;flex-direction:column;min-width:0;background:var(--card-bg);border:1px solid var(--border);border-radius:12px;overflow:hidden}
.tfr-tool .ph{flex:none;padding:.75rem 1.1rem .7rem;border-bottom:1px solid var(--border);display:grid;gap:.45rem}
.tfr-tool .ph>*{min-width:0}
.tfr-tool .ph-row{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem .8rem}
.tfr-tool .srcl{display:flex;align-items:center;gap:.45rem;font:.875rem/1.2 var(--sans);color:var(--muted);min-width:0;flex:1 1 14rem}
.tfr-tool .pane select{appearance:auto;min-width:0;flex:1;width:100%;max-width:100%;text-overflow:ellipsis;border:1px solid var(--border);border-radius:8px;background:var(--bg);padding:.4rem .5rem;font:.875rem/1.3 var(--sans);color:var(--fg);min-height:2.25rem}
.tfr-tool .open{font:600 .8125rem/1.2 var(--sans);white-space:nowrap;text-decoration:underline;text-underline-offset:3px}
.tfr-tool .ph h2{font:500 1.5rem/1.2 var(--font-display);margin:.1rem 0 0;text-wrap:balance}
.tfr-tool .ph h2 small{font:400 .875rem/1 var(--sans);color:var(--muted);margin-left:.4rem;white-space:nowrap}
.tfr-tool .ph .what{margin:0;font:italic 1rem/1.4 var(--font-display);color:var(--muted)}
.tfr-tool .back{appearance:none;border:0;background:none;padding:0;font:600 .8125rem/1.2 var(--sans);color:var(--muted);cursor:pointer;text-decoration:underline;text-underline-offset:3px;justify-self:start}
.tfr-tool .arts{display:flex;gap:.35rem;flex-wrap:wrap}
.tfr-tool .arts .chip{padding:.28rem .65rem;font-size:.8125rem}
.tfr-tool .scroll{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;padding:.4rem 1.2rem 2.5rem;scroll-padding-top:.75rem}
.tfr-tool .pg{padding:.2rem 0 .6rem}
.tfr-tool .pgno{display:flex;align-items:center;gap:.6rem;margin:.9rem 0 .5rem;font:600 .75rem/1 var(--sans);letter-spacing:.04em;color:var(--muted);text-decoration:none;font-variant-numeric:tabular-nums}
.tfr-tool .pgno::after{content:"";flex:1;border-top:1px solid var(--border)}
.tfr-tool .pgno:hover{color:var(--fg)}
.tfr-tool .ln{font:1.0625rem/1.72 var(--font-body);max-width:68ch;text-wrap:pretty}
.tfr-tool .ln p{margin:0 0 .85rem}
.tfr-tool .ln .cap{margin:0 0 .2rem;font-size:.9375rem;color:var(--muted)}
.tfr-tool .ln .cap+p:not(.cap){margin-top:.8rem}
.tfr-tool .ln .hd{font:600 1.0625rem/1.4 var(--font-display);margin:1.2rem 0 .55rem;text-wrap:balance;scroll-margin-top:.75rem}
.tfr-tool .ln .hd.sc{font-variant-caps:all-small-caps;letter-spacing:.035em;font-size:1.1875rem}
.tfr-tool .duo{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.4rem}
.tfr-tool .duo .ln{font-size:1rem}
.tfr-tool .anc{display:block;height:0;scroll-margin-top:.75rem}
.tfr-tool .flash{animation:flash 1.6s var(--ease)}
.tfr-tool .end{margin:1.4rem 0 0;padding-top:.9rem;border-top:1px solid var(--border);color:var(--muted);font-size:.9375rem}
.tfr-tool .note{color:var(--muted);margin:1rem 0;max-width:60ch}
.tfr-tool .sk{display:grid;gap:.7rem;padding:1.2rem 0}
.tfr-tool .sk i{display:block;height:.8rem;border-radius:4px;background:var(--highlight)}
.tfr-tool .sk i:nth-child(3n){width:72%}
.tfr-tool .sk i:nth-child(3n+1){width:94%}
.tfr-tool .sk i:nth-child(3n+2){width:86%}
.tfr-tool .find{width:100%;border:1px solid var(--border);border-radius:8px;background:var(--bg);padding:.45rem .65rem;font:.9375rem/1.3 var(--sans);min-height:2.25rem}
.tfr-tool .find::placeholder{color:var(--muted)}
.tfr-tool .count{margin:0;color:var(--muted);font-size:.875rem}
.tfr-tool .trad{margin:1rem 0 .1rem;padding-bottom:.3rem;border-bottom:1px solid var(--border);font:500 1rem/1.3 var(--font-display);color:var(--muted)}
.tfr-tool .trad span{font:.8125rem/1 var(--sans);margin-left:.3rem}
.tfr-tool .dir{list-style:none;margin:0;padding:0}
.tfr-tool .c{border-bottom:1px solid var(--border);padding:.15rem 0 .35rem}
.tfr-tool .c-top{display:flex;align-items:flex-start;gap:.6rem}
.tfr-tool .c-read{appearance:none;border:0;background:none;text-align:left;cursor:pointer;flex:1;min-width:0;padding:.5rem .45rem;margin:0 -.45rem;border-radius:8px;display:grid;gap:.1rem}
.tfr-tool .c-read:hover{background:var(--highlight)}
.tfr-tool .who{font:500 1.125rem/1.25 var(--font-display)}
.tfr-tool .who small{font:.75rem/1 var(--sans);color:var(--muted);margin-left:.35rem}
.tfr-tool .work{color:var(--muted);font-size:.875rem;line-height:1.35}
.tfr-tool .sum{font-size:.8125rem;color:var(--muted);font-variant-numeric:tabular-nums}
.tfr-tool .c .ext{flex:none;margin-top:.6rem;font:600 .75rem/1.2 var(--sans);white-space:nowrap}
.tfr-tool .toc{margin:0 0 .2rem}
.tfr-tool .toc summary{cursor:pointer;font:600 .75rem/1.2 var(--sans);color:var(--muted);padding:.25rem 0;width:max-content}
.tfr-tool .toc ol{list-style:none;margin:.2rem 0 .5rem;padding:0;display:grid;gap:.05rem}
.tfr-tool .toc li{display:flex;align-items:baseline;gap:.6rem}
.tfr-tool .toc li button{appearance:none;border:0;background:none;padding:.2rem .3rem;margin:0 -.3rem;border-radius:5px;text-align:left;cursor:pointer;font:.875rem/1.35 var(--font-body);flex:1;min-width:0}
.tfr-tool .toc li button:hover{background:var(--highlight)}
.tfr-tool .toc li a{flex:none;font-size:.75rem;color:var(--muted);font-variant-numeric:tabular-nums;text-underline-offset:2px}
.tfr-tool .toc .d1 button{font-weight:600}
.tfr-tool .toc .d2{padding-left:.9rem}
.tfr-tool .toc .d3{padding-left:1.8rem}
.tfr-tool .toc .d3 button{color:var(--muted)}
.tfr-tool .c[aria-current="true"] .c-read{background:var(--highlight)}
.tfr-tool .absent{margin:1.4rem 0 0;border-top:1px solid var(--border)}
.tfr-tool .absent>summary{cursor:pointer;list-style:none;padding:.75rem 0 .3rem;font:500 1rem/1.3 var(--font-display);color:var(--muted)}
.tfr-tool .absent>summary::-webkit-details-marker{display:none}
.tfr-tool .absent>summary::before{content:"+";display:inline-block;width:1.1rem;font:400 1rem/1 var(--sans)}
.tfr-tool .absent[open]>summary::before{content:"\2212"}
.tfr-tool .absent>summary span{font:.8125rem/1 var(--sans);margin-left:.35rem}
.tfr-tool .absent>.count{margin:.1rem 0 .2rem}
.tfr-tool .c-who{display:grid;gap:.1rem;padding:.5rem 0}
.tfr-tool .near{font-size:.8125rem;color:var(--muted);font-variant-numeric:tabular-nums}
.tfr-tool .c-many .vols{list-style:none;margin:.15rem 0 .2rem;padding:0 0 0 1rem}
.tfr-tool .c-many .vols li{display:grid;gap:.05rem;padding:.3rem 0;font-size:.9rem}
.tfr-tool .c-many>.c-who{padding-bottom:.1rem}
.tfr-tool .near a{color:var(--fg);text-underline-offset:2px}
.tfr-tool .abs-note{max-width:62ch;margin:1.1rem 0}
.tfr-tool .abs-note p{margin:0 0 .7rem;text-wrap:pretty}
.tfr-tool .abs-note p:first-child{font:500 1.0625rem/1.5 var(--font-display)}
.tfr-tool .grid.sys{grid-template-columns:repeat(auto-fill,minmax(13rem,1fr))}
.tfr-tool .grid.sys .gpart{grid-column:1/-1;margin:.4rem 0 0;padding-bottom:.2rem;border-bottom:1px solid var(--border);font:500 1rem/1.3 var(--font-display);color:var(--muted)}
.tfr-tool .grid.sys .gpart:first-child{margin-top:0}
.tfr-tool .grid.sys button{flex-direction:row;justify-content:space-between;align-items:baseline;gap:.6rem;padding:.45rem .6rem;text-align:left;font:.9375rem/1.3 var(--font-body)}
@media (max-width:980px){.tfr-tool .desk{grid-template-columns:minmax(0,1fr)}
.tfr-tool .pane{position:static;height:auto;overflow:visible}
.tfr-tool .scroll{overflow:visible;padding-bottom:1.5rem}
.tfr-tool .switch{display:flex;position:sticky;top:var(--sticky);z-index:2;margin:0 0 .6rem;background:var(--bg);padding:.3rem 0}
.tfr-tool .switch .seg{width:100%}
.tfr-tool .switch .seg button{flex:1}
.tfr-tool .desk[data-show="a"] #paneB,.tfr-tool .desk[data-show="b"] #paneA{display:none}
.tfr-tool .duo{grid-template-columns:1fr;gap:.2rem}
.tfr-tool .duo .ln+.ln{border-top:1px dashed var(--border);padding-top:.6rem}}
@media (max-width:640px){.tfr-tool .wrap{padding:1rem 1rem 3rem}
.tfr-tool h1{font-size:1.6rem}
.tfr-tool .lede{display:none}
.tfr-tool .tabs{gap:1.1rem;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none}
.tfr-tool .tabs::-webkit-scrollbar{display:none}
.tfr-tool .tabs button{white-space:nowrap;flex:none}
.tfr-tool .stepper{width:100%}
.tfr-tool .stepper #pick{min-width:0;flex:1}
.tfr-tool .ph{padding:.7rem .9rem}
.tfr-tool .scroll{padding:.3rem .9rem 1.5rem}}
@media (prefers-reduced-motion:no-preference){.tfr-tool .grid button,.tfr-tool .chip,.tfr-tool .seg button,.tfr-tool .c-read,.tfr-tool .toc li button{transition:background .15s var(--ease),color .15s var(--ease),border-color .15s var(--ease)}
.tfr-tool .sk i{animation:sk 1.4s ease-in-out infinite}}
@media (prefers-reduced-motion:reduce){.tfr-tool .flash{animation:none;background:var(--highlight)}}
/* the Reformed, Vitringa and Lutheran decks (2026-10-22), as decks.html has them; Vitringa as the data session's reviewed prototype sets him; the problems of the Reformed deck (Voetius's Syllabus) and of the Lutheran (Quenstedt's questions) with their seals, filters, forks, folds, objections, who-agrees strip and graph band (tradition-graphics.css's share bars) */
.tfr-tool .vnote{margin:.1rem 0 0;font-size:.875rem;color:var(--muted)}
.tfr-tool .altsw{justify-self:start}
.tfr-tool .altsw button{min-width:5.5rem}
.tfr-tool .morebar{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem .8rem;margin:1.2rem 0 0;padding-top:.9rem;border-top:1px solid var(--border)}
.tfr-tool .morebar button{border:1px solid var(--border);background:var(--card-bg);border-radius:8px;padding:.45rem .9rem;min-height:2.25rem;cursor:pointer;font:600 .8125rem/1.2 var(--sans)}
.tfr-tool .morebar button:disabled{opacity:.5;cursor:default}
.tfr-tool .morebar span{color:var(--muted);font-size:.875rem}
.tfr-tool .c .pv{margin:-.1rem 0 .35rem;color:var(--muted);font-size:.875rem;line-height:1.45;max-width:62ch;text-wrap:pretty}
.tfr-tool .pvnote{margin:.7rem 0 0;color:var(--muted);font-size:.8125rem}
@media (min-width:981px){.tfr-tool .desk[data-view="vitringa"]{grid-template-columns:minmax(0,1.6fr) minmax(0,1fr)}
}
.tfr-tool .bscroll{container-type:inline-size}
.tfr-tool .bscroll .ln{max-width:none}
.tfr-tool .bscroll .ln>:is(p,h3){max-width:68ch}
.tfr-tool .ap{display:grid;grid-template-columns:2rem minmax(0,1fr);column-gap:.6rem;align-items:baseline;margin:0 0 1.15rem;scroll-margin-top:.75rem}
.tfr-tool .ap .num{grid-column:1;justify-self:end;font:500 1.0625rem/1 var(--font-display);color:var(--muted);font-variant-numeric:oldstyle-nums;padding-top:.1em;text-decoration:none;white-space:nowrap;border-radius:3px}
.tfr-tool .ap .num:hover{color:var(--fg)}
.tfr-tool .ln .ap>p{grid-column:2;margin:0;font:1.0625rem/1.68 var(--font-body);text-wrap:pretty;hyphens:auto}
.tfr-tool .ap .refs{grid-column:2;margin-top:.25rem;font:italic .8125rem/1.5 var(--font-display);color:var(--muted)}
.tfr-tool .ln .ap .plain{grid-column:2;margin:0 0 1.1rem;font:1rem/1.65 var(--font-body);color:var(--muted)}
.tfr-tool .ap.plain-row{margin:0}
.tfr-tool .ln .ap .sec{grid-column:2;margin:2rem 0 1rem;font:500 1.375rem/1.25 var(--font-display);text-wrap:balance}
@container (min-width:46rem){.tfr-tool .ap{grid-template-columns:3.25rem minmax(0,44rem) minmax(0,10rem);column-gap:1.25rem}
.tfr-tool .ap .refs{grid-column:3;margin-top:0;font-size:.875rem}
}
.tfr-tool .duo .ap{grid-template-columns:2rem minmax(0,1fr);column-gap:.6rem}
.tfr-tool .duo .ap .refs{grid-column:2;margin-top:.25rem;font-size:.8125rem}
.tfr-tool .mk{appearance:none;border:0;background:none;padding:0 .1em;margin-left:.15em;font:600 .72em/1 var(--font-body);vertical-align:.55em;color:var(--muted);cursor:pointer;border-radius:3px;font-variant-numeric:lining-nums}
.tfr-tool .mk:hover,.tfr-tool .mk[aria-expanded="true"]{color:var(--fg)}
.tfr-tool .mk[aria-expanded="true"]{background:var(--highlight)}
.tfr-tool .card{grid-column:2;margin:.75rem 0 .25rem;padding:.95rem 1.1rem 1rem;background:var(--tint);border:1px solid var(--border);border-radius:10px}
.tfr-tool .card[hidden]{display:none}
.tfr-tool .ln .card .lbl{display:flex;align-items:baseline;gap:.5rem;margin:0 0 .35rem;font:italic .9375rem/1.3 var(--font-display);color:var(--muted)}
.tfr-tool .card .lbl b{font:600 .8125rem/1 var(--font-body);font-style:normal;color:var(--fg)}
.tfr-tool .card .sc{font-variant-caps:all-small-caps;letter-spacing:.03em}
.tfr-tool .ln .card .nt{margin:0;font:.9375rem/1.62 var(--font-body);text-wrap:pretty}
.tfr-tool .ln .card .held{margin:.7rem 0 0;font:.875rem/1.7 var(--font-body)}
.tfr-tool .card .held-l{font-style:italic;color:var(--muted);font-family:var(--font-display)}
.tfr-tool .card :is(.nt,.held) .ref{color:var(--fg);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px;text-decoration-color:var(--muted);cursor:pointer;border-radius:3px}
.tfr-tool .card :is(.nt,.held) .ref:hover{text-decoration-color:var(--fg);background:var(--highlight)}
.tfr-tool .card .ref[aria-pressed="true"]{background:var(--highlight);text-decoration-color:var(--fg)}
.tfr-tool .card .tag{margin-left:.25em;padding:0 .3em;border:1px solid var(--border);border-radius:4px;font:600 .72em/1.3 var(--font-body);color:var(--muted);white-space:nowrap;vertical-align:.12em;-webkit-user-select:none;user-select:none;font-variant-numeric:tabular-nums}
.tfr-tool .card .tag::before{content:attr(data-t)}
.tfr-tool .tip{position:fixed;z-index:920;max-width:min(22rem,calc(100vw - 1.5rem));padding:.55rem .7rem;border:1px solid var(--border);border-radius:8px;background:var(--tint);font:.8125rem/1.45 var(--font-body);color:var(--fg);pointer-events:none;opacity:0;transform:translateY(2px)}
.tfr-tool .tip.on{opacity:1;transform:none}
.tfr-tool .bh .who{margin:0;font:500 1.25rem/1.25 var(--font-display);text-wrap:balance}
.tfr-tool .bh .what{margin:.2rem 0 0;font:italic .9375rem/1.4 var(--font-display);color:var(--muted)}
