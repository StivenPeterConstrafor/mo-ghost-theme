{{!< default}}
{{!-- The TFR rail, first on the page and pinned under the masthead as on the reader (Ian, 2026-09-23). --}}
{{> "faith-received/_tfr-rail"}}
{{#contentFor "moHead"}}
<title>Commentary decks | The Faith Received | Mere Orthodoxy</title>
<meta name="description" content="Lombard's Sentences, Aquinas's Summa, the Decretals and Gratian's Decretum, place by place, with every commentator the library holds on each." />
<link rel=preconnect href="https://fonts.googleapis.com"><link rel=preconnect href="https://fonts.gstatic.com" crossorigin>
<link rel=stylesheet href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Source+Serif+Pro:ital,wght@0,400;0,600;1,400&display=swap">
<style>
.tfr-tool{--bg:#FFFFFF;--fg:#1C1C1A;--muted:#5A5A56;--accent2:#3A3A36;--border:#D8D8D3;--card-bg:#FFFFFF;--highlight:#EFEFEA;
  --font-display:'EB Garamond',Georgia,serif;--font-body:'Source Serif Pro',Georgia,serif;--sans:'Source Serif Pro',Georgia,serif;}
.tfr-tool *{box-sizing:border-box}
.tfr-tool{margin:0;background:var(--bg);color:var(--fg);font:16px/1.62 var(--font-body);-webkit-font-smoothing:antialiased}
.tfr-tool a{color:var(--fg)}
.tfr-tool .top{background:var(--bg);padding:1rem 1.4rem .8rem;display:flex;align-items:baseline;gap:.9rem;flex-wrap:wrap;border-bottom:1px solid var(--border)}
.tfr-tool .top .wm{font:500 1.25rem/1 var(--font-display);text-decoration:none}
.tfr-tool .top .sub{font:italic 1rem/1 var(--font-display);color:var(--muted)}
.tfr-tool .top a.back{margin-left:auto;color:var(--muted);font:600 .75rem/1 var(--sans);text-decoration:none;padding:.4rem .75rem;border:1px solid var(--border);border-radius:999px}
.tfr-tool .top a.back:hover{color:var(--fg);border-color:var(--fg)}
.tfr-tool .wrap{max-width:60rem;margin:0 auto;padding:1.8rem 1.2rem 4rem}
.tfr-tool h1{font:500 2rem/1.2 var(--font-display);margin:.2rem 0 .6rem;text-wrap:balance}
.tfr-tool .lede{max-width:68ch;color:var(--muted);margin:0 0 1.4rem;text-wrap:pretty}
.tfr-tool .tabs{display:flex;flex-wrap:wrap;gap:0 1.6rem;border-bottom:1px solid var(--border);margin:0 0 1.1rem}
.tfr-tool .tabs button{appearance:none;border:0;background:none;padding:.6rem 0;margin-bottom:-1px;font:500 1.25rem/1.2 var(--font-display);color:var(--muted);border-bottom:2px solid transparent;cursor:pointer}
.tfr-tool .tabs button[aria-selected="true"]{color:var(--fg);border-bottom-color:var(--fg)}
.tfr-tool .tabs button:focus-visible,.tfr-tool .parts button:focus-visible,.tfr-tool .grid button:focus-visible,.tfr-tool .arts button:focus-visible{outline:2px solid var(--fg);outline-offset:2px}
.tfr-tool .parts{display:flex;gap:.4rem;flex-wrap:wrap;margin:0 0 .9rem}
.tfr-tool .parts button,.tfr-tool .arts button{border:1px solid var(--border);background:var(--card-bg);color:var(--fg);padding:.38rem .8rem;border-radius:999px;font:600 .875rem/1.2 var(--sans);cursor:pointer}
.tfr-tool .parts button[aria-pressed="true"],.tfr-tool .arts button[aria-pressed="true"]{background:var(--fg);border-color:var(--fg);color:var(--bg)}
.tfr-tool .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(3.4rem,1fr));gap:.35rem;margin:0 0 1.6rem}
.tfr-tool .grid button{display:flex;flex-direction:column;align-items:center;gap:.1rem;padding:.4rem .2rem;border:1px solid var(--border);background:var(--card-bg);color:var(--fg);border-radius:6px;cursor:pointer;font:500 1rem/1 var(--font-display)}
.tfr-tool .grid button small{font:600 .75rem/1 var(--sans);color:var(--muted);font-variant-numeric:tabular-nums}
.tfr-tool .grid button[aria-pressed="true"]{background:var(--fg);color:var(--bg);border-color:var(--fg)}
.tfr-tool .grid button[aria-pressed="true"] small{color:var(--bg)}
.tfr-tool .grid button.empty{opacity:.45}
.tfr-tool .place{border-top:1px solid var(--border);padding-top:1.2rem}
.tfr-tool .place h2{font:500 1.6rem/1.25 var(--font-display);margin:0 0 .25rem;text-wrap:balance}
.tfr-tool .place .what{color:var(--muted);margin:0 0 .9rem;font-style:italic}
.tfr-tool .text-link{display:inline-flex;gap:.4rem;align-items:center;font:600 .875rem/1 var(--sans);text-decoration:none;border:1px solid var(--fg);padding:.5rem .8rem;border-radius:999px;margin:0 0 1rem}
.tfr-tool .text-link:hover{background:var(--fg);color:var(--bg)}
.tfr-tool .arts{display:flex;gap:.35rem;flex-wrap:wrap;margin:0 0 1rem}
.tfr-tool .trad{margin:1.2rem 0 .2rem;padding-bottom:.35rem;border-bottom:1px solid var(--border);font:500 1rem/1.3 var(--font-display);color:var(--muted)}
.tfr-tool .rows{list-style:none;margin:0;padding:0}
.tfr-tool .rows li{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.2rem 1rem;align-items:start;padding:.7rem 0;border-bottom:1px solid var(--border)}
.tfr-tool .rows .who{font:500 1rem/1.3 var(--font-display)}
.tfr-tool .rows .who small{font:400 .875rem/1 var(--sans);color:var(--muted);margin-left:.35rem}
.tfr-tool .rows .work{grid-column:1;color:var(--muted);font-size:.875rem}
.tfr-tool .rows .head{grid-column:1;font-size:.875rem;font-style:italic}
.tfr-tool .rows .read{grid-column:2;grid-row:1 / span 3;align-self:center;font:600 .75rem/1 var(--sans);text-decoration:none;border:1px solid var(--border);padding:.45rem .7rem;border-radius:999px;white-space:nowrap}
.tfr-tool .rows .read:hover{border-color:var(--fg)}
.tfr-tool .muted{color:var(--muted)}
@media (max-width:640px){.tfr-tool .wrap{padding:1.2rem 1rem 3rem}
.tfr-tool h1{font-size:1.6rem}
.tfr-tool .tabs{gap:1.1rem;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none}
.tfr-tool .tabs::-webkit-scrollbar{display:none}
.tfr-tool .tabs button{white-space:nowrap;flex:none}
.tfr-tool .grid{grid-template-columns:repeat(auto-fill,minmax(2.9rem,1fr))}}
@media (prefers-reduced-motion:no-preference){.tfr-tool .grid button,.tfr-tool .parts button,.tfr-tool .arts button{transition:background .15s,color .15s,border-color .15s}}
.tfr-tool{background:transparent}
.tfr-tool .wrap{padding-top:1.2rem}
</style>
{{/contentFor}}
{{!-- /the-faith-received/commentary-decks/ — Commentary decks, as The Faith Received has it (tools/prdl_reader_prototype/decks.html), in this site's
     shell: the hero is the theme's, the body and its script (faith-decks.js) the library's, reading the library worker. --}}
<section class="bhero bhero--tool">
  <div class="bhero-inner container">
    <p class="bhero-kicker"><a href="/the-faith-received/">The Faith Received</a> <span aria-hidden="true">&middot;</span> Commentary decks</p>
    <h1 class="bhero-title">The commented texts, with their commentators</h1>
    <p class="bhero-lede">Choose a distinction of Peter Lombard's Sentences, a question of Thomas Aquinas's Summa, a title of Gregory IX's Decretals or a distinction or causa of Gratian's Decretum: the text itself, and every commentary the library holds on that place, each opening at its page.</p>
  </div>
</section>
<script src="{{asset "js/page/faith-tfr-rail.js"}}" defer></script>
<main class="tfr-tool"><div class="wrap">
  <div class="tabs" role="tablist" aria-label="Commented text">
    <button type="button" role="tab" id="tab-sentences" aria-selected="true" data-deck="sentences">Lombard's Sentences</button>
    <button type="button" role="tab" id="tab-summa" aria-selected="false" data-deck="summa">Aquinas's Summa</button>
    <button type="button" role="tab" id="tab-decretals" aria-selected="false" data-deck="decretals">The Decretals</button>
    <button type="button" role="tab" id="tab-decretum" aria-selected="false" data-deck="decretum">Gratian's Decretum</button>
  </div>
  <div class="parts" id="parts" role="group" aria-label="Book or part"></div>
  <div class="grid" id="grid" role="group" aria-label="Places"></div>
  <section class="place" id="place" aria-live="polite"><p class="muted">Loading the decks…</p></section>

</div></main>
<script src="{{asset "js/faith-decks.js"}}&amp;frv=67cfaf261fc4c707"></script>
