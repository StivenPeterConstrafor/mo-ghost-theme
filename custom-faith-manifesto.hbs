  {{!-- THE SIGNATURE. Ian, 2026-09-22: the manifesto is signed, and the
        people who built the thing stand under it. Same cards as the
        About page's team, with the portrait taken from each person's
        Ghost author-* tag. The bio is the tag's own description rather
        than copy repeated here, so it stays in step with the
        contributors page; About hardcodes its bios only because it also
        prints a role, and the role here is the label above. --}}
  <section class="bband bband--cream faith-mf-sign">
    <div class="container">
      <div class="section-intro">
        <p class="eyebrow">Principal Architects</p>
      </div>
      <div class="contributors-grid faith-mf-people">
        {{#get "tags" filter="slug:author-ian-harber" limit="1"}}
          {{#foreach tags}}
          <div class="contributor-card contributor-card--static">
            <div class="contributor-card-portrait" aria-hidden="true">
              {{#if feature_image}}<img src="{{img_url feature_image size="s"}}" alt="Ian Harber" />{{else}}<span class="contributor-card-initial">Ian Harber</span>{{/if}}
            </div>
            <div class="contributor-card-body">
              <h3 class="contributor-card-name"><a href="{{url}}"><em>Ian Harber</em></a></h3>
              {{#if description}}<p class="contributor-card-bio">{{description}}</p>{{/if}}
            </div>
          </div>
          {{/foreach}}
        {{/get}}
        {{#get "tags" filter="slug:author-stiven-peter" limit="1"}}
          {{#foreach tags}}
          <div class="contributor-card contributor-card--static">
            <div class="contributor-card-portrait" aria-hidden="true">
              {{#if feature_image}}<img src="{{img_url feature_image size="s"}}" alt="Stiven Peter" />{{else}}<span class="contributor-card-initial">Stiven Peter</span>{{/if}}
            </div>
            <div class="contributor-card-body">
              <h3 class="contributor-card-name"><a href="{{url}}"><em>Stiven Peter</em></a></h3>
              {{#if description}}<p class="contributor-card-bio">{{description}}</p>{{/if}}
            </div>
          </div>
          {{/foreach}}
        {{/get}}
      </div>
    </div>
  </section>

