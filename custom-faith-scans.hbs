{{!< default}}
{{> "faith-received/_tfr-rail"}}
{{#contentFor "moHead"}}
<title>Page Scans &mdash; The Faith Received</title>
<meta name="description" content="Every work in The Faith Received that you can read beside the printed page it was transcribed from." />
<meta name="tfr-room-collection" content="all" />
{{!-- The All Works room with the page-scan filter fixed on (faith-room.js
     reads this meta). The list of scanned works is
     assets/data/faith-received/scanned-works.json. --}}
<meta name="tfr-room-scans" content="1" />
{{/contentFor}}
{{!-- /the-faith-received/scans/ — the works with page scans (Ian,
     2026-09-24: "I feel like we should have a page just of works that
     contain page scans"). The same search, filters and A-Z as All Works,
     over only the works whose reader can show the printed page. --}}

<main class="faith-received faith-room">

  <section class="bhero bhero--tool">
    <div class="bhero-inner container">
      <p class="bhero-kicker"><a href="/the-faith-received/">The Faith Received</a> <span aria-hidden="true">&middot;</span> <a href="/the-faith-received/scans/">Page Scans</a></p>
      <h1 class="bhero-title">Page Scans</h1>
      <p class="bhero-lede">Works you can read beside the printed page they were transcribed from. Open one and choose Scan to see the page.</p>
      <p class="bhero-actions">
        <a class="bhero-btn" href="/the-faith-received/all-works/?collection=all">Full Library</a>
      </p>
    </div>
  </section>
<script src="{{asset "js/page/faith-tfr-rail.js"}}" defer></script>

  <section class="bband faith-room-body">
    <div class="container">
      <div data-faith-room data-fr-bookmark-rows></div>
    </div>
  </section>

{{> "faith-received/_beta-band"}}
</main>
{{> "faith-received/_library-cta"}}

