.tfr-tool .side .pos{margin:0;text-wrap:pretty}
.tfr-tool .ops{margin:1.4rem 0 1rem;border-top:1px solid var(--fg)}
.tfr-tool .op{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:.2rem 1.6rem;padding:1rem 0 .8rem;border-bottom:1px solid var(--border)}
.tfr-tool .op h3{font:500 1.25rem/1.3 var(--font-display);margin:0 0 .25rem;text-wrap:balance;overflow-wrap:anywhere}
