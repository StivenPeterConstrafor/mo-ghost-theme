.tfr-tool .op .pos{margin:0;text-wrap:pretty}
.tfr-tool .res{margin:.2rem 0 .8rem;padding:.6rem .8rem;border:1px solid var(--border);border-radius:6px;background:var(--card-bg)}
.tfr-tool .res .lbl{margin:0 0 .2rem;color:var(--fg);display:block}
.tfr-tool .res .pos{margin:0;text-wrap:pretty}
.tfr-tool .judgment .lbl{margin:1rem 0 .3rem}
.tfr-tool p.who{margin:0 0 .35rem;font:600 1rem/1.4 var(--font-body);overflow-wrap:anywhere}
.tfr-tool p.who a{text-decoration-thickness:1px;text-underline-offset:3px}
.tfr-tool .side .pos+.who,.tfr-tool .side .own+.who{margin-top:.9rem}
.tfr-tool ol.args{counter-reset:arg}
.tfr-tool ol.args>li{grid-template-columns:1rem minmax(0,1fr) auto;column-gap:.6rem}
.tfr-tool ol.args>li::before{counter-increment:arg;content:counter(arg);color:var(--muted);font:600 .8rem/1.6 var(--sans);font-variant-numeric:tabular-nums}
.tfr-tool .gist{margin:0 0 .6rem;text-wrap:pretty}
.tfr-tool figure.own{margin:0 0 .9rem}
.tfr-tool .side>figure.own:first-of-type,.tfr-tool .side>h5+figure.own{margin-top:.7rem}
.tfr-tool figure.own blockquote{margin:0;padding:0 0 0 .85rem;border-left:1px solid var(--muted);font-style:italic;text-wrap:pretty}
.tfr-tool figure.own blockquote p{margin:0}
.tfr-tool figure.own figcaption{display:flex;align-items:baseline;justify-content:space-between;gap:.3rem 1rem;margin:.3rem 0 0 .85rem;font-size:.8rem;color:var(--muted)}
.tfr-tool figure.own .says{margin:.25rem 0 0 .85rem;font-size:.8rem;color:var(--muted);text-wrap:pretty}
.tfr-tool .judgment{margin:1.2rem 0 0;padding:1rem 1.1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:8px}
