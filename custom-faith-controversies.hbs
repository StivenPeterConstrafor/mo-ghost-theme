.tfr-tool .fold[open]>summary::before{content:"\2212"}
.tfr-tool .rows{list-style:none;margin:0;padding:0}
.tfr-tool .rows>li{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.2rem 1rem;align-items:baseline;padding:.45rem 0;border-top:1px solid var(--border);text-wrap:pretty}
