.tfr-tool .books li button:hover{background:var(--highlight)}
.tfr-tool .books li button[aria-current="true"]{background:var(--fg);color:var(--bg)}
.tfr-tool .books li button small{display:block;color:var(--muted);font:.8rem/1.3 var(--sans)}
.tfr-tool .books li button[aria-current="true"] small{color:inherit;opacity:.8}
.tfr-tool .c-head h2,.tfr-tool .c-head h4.qh{font:500 1.6rem/1.25 var(--font-display);margin:0 0 .6rem;text-wrap:balance}
.tfr-tool .c-head .lab{max-width:none}
.tfr-tool .kind{display:inline-block;padding:.05rem .55rem;border:1px solid var(--border);border-radius:999px;font:600 .8rem/1.5 var(--sans)}
.tfr-tool .pg{font-size:.8rem;white-space:nowrap;font-variant-numeric:tabular-nums}
.tfr-tool .r1{display:flex;align-items:baseline;justify-content:space-between;gap:.4rem 1rem}
.tfr-tool .r1>span{min-width:0}
.tfr-tool .fold{margin:.7rem 0 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.tfr-tool .fold>summary{cursor:pointer;padding:.45rem 0;font:600 .8rem/1.4 var(--sans);color:var(--muted);list-style:none}
.tfr-tool .fold>summary::-webkit-details-marker{display:none}
