.tfr-tool .tip .tip-x{position:absolute;top:.2rem;right:.3rem;min-width:1.75rem;min-height:1.75rem;padding:0;border:0;background:none;color:var(--muted);font:1rem/1 var(--sans);cursor:pointer}
