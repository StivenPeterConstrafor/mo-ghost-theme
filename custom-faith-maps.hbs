.tfr-tool .lg button.ring i{background:var(--card-bg);box-shadow:inset 0 0 0 2px var(--fg)}
.tfr-tool .lg button.ring[aria-pressed="false"] i{background:var(--card-bg);box-shadow:inset 0 0 0 2px var(--fg);opacity:.35}
.tfr-tool .tip{position:absolute;z-index:3;max-width:22rem;padding:.6rem .75rem;border:1px solid var(--border);border-radius:6px;background:var(--card-bg);box-shadow:0 4px 14px rgba(0,0,0,.08);font-size:.8rem;line-height:1.5;pointer-events:auto}
