{{!< default}}
{{!-- The TFR rail, first on the page and pinned under the masthead as on the reader (Ian, 2026-09-23). --}}
{{> "faith-received/_tfr-rail"}}
{{#contentFor "moHead"}}
<title>Index of the set | The Faith Received | Mere Orthodoxy</title>
<meta name="description" content="One index for a whole set of volumes: subjects, persons, Scripture, terms and questions, each entry naming its volume and pages." />
<link rel=preconnect href="https://fonts.googleapis.com"><link rel=preconnect href="https://fonts.gstatic.com" crossorigin>
<link rel=stylesheet href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Source+Serif+Pro:ital,wght@0,400;0,600;1,400&display=swap">
<style>
.tfr-tool{--bg:#FFFFFF;--fg:#1C1C1A;--muted:#5A5A56;--border:#D8D8D3;--card-bg:#FFFFFF;--highlight:#EFEFEA;
  --font-display:'EB Garamond',Georgia,serif;--font-body:'Source Serif Pro',Georgia,serif;--sans:'Source Serif Pro',Georgia,serif;}
.tfr-tool *{box-sizing:border-box}
.tfr-tool{margin:0;background:var(--bg);color:var(--fg);font:16px/1.62 var(--font-body);-webkit-font-smoothing:antialiased}
.tfr-tool a{color:var(--fg)}
.tfr-tool .top{padding:1rem 1.4rem .8rem;display:flex;align-items:baseline;gap:.9rem;flex-wrap:wrap;border-bottom:1px solid var(--border)}
.tfr-tool .top .wm{font:500 1.25rem/1 var(--font-display);text-decoration:none}
.tfr-tool .top .sub{font:italic 1rem/1 var(--font-display);color:var(--muted)}
.tfr-tool .wrap{max-width:64rem;margin:0 auto;padding:1.8rem 1.2rem 4rem}
.tfr-tool h1{font:500 2rem/1.2 var(--font-display);margin:.2rem 0 .3rem;text-wrap:balance}
.tfr-tool .by{color:var(--muted);margin:0 0 1.2rem}
.tfr-tool .tabs{display:flex;flex-wrap:wrap;gap:0 1.6rem;border-bottom:1px solid var(--border);margin:0 0 1rem}
.tfr-tool .tabs button{appearance:none;border:0;background:none;padding:.6rem 0;margin-bottom:-1px;font:500 1.25rem/1.2 var(--font-display);color:var(--muted);border-bottom:2px solid transparent;cursor:pointer}
.tfr-tool .tabs button small{font:.8rem/1 var(--sans);margin-left:.3rem;font-variant-numeric:tabular-nums}
.tfr-tool .tabs button[aria-selected="true"]{color:var(--fg);border-bottom-color:var(--fg)}
.tfr-tool .find{display:flex;gap:.5rem;margin:0 0 .8rem}
.tfr-tool .find input{flex:1;min-width:0;font:1rem/1.3 var(--font-body);padding:.6rem .8rem;border:1px solid var(--border);border-radius:8px;background:var(--card-bg);color:var(--fg)}
.tfr-tool .find input:focus-visible,.tfr-tool .tabs button:focus-visible,.tfr-tool .letters button:focus-visible,.tfr-tool .list button:focus-visible,.tfr-tool .more:focus-visible,.tfr-tool .chips button:focus-visible{outline:2px solid var(--fg);outline-offset:2px}
.tfr-tool .letters,.tfr-tool .chips{display:flex;flex-wrap:wrap;gap:.25rem;margin:0 0 1.1rem}
.tfr-tool .letters button,.tfr-tool .chips button{min-width:2rem;padding:.3rem .5rem;border:1px solid var(--border);background:var(--card-bg);color:var(--fg);border-radius:6px;font:500 .8rem/1 var(--font-display);cursor:pointer}
.tfr-tool .letters button[aria-pressed="true"],.tfr-tool .chips button[aria-pressed="true"]{background:var(--fg);color:var(--bg);border-color:var(--fg)}
.tfr-tool .cols{display:grid;grid-template-columns:minmax(13rem,19rem) minmax(0,1fr);gap:1.6rem;align-items:start}
.tfr-tool .list{list-style:none;margin:0;padding:0;max-height:72vh;overflow:auto;border-top:1px solid var(--border)}
.tfr-tool .list li button{display:flex;justify-content:space-between;gap:.6rem;width:100%;text-align:left;padding:.42rem .3rem;border:0;border-bottom:1px solid var(--border);background:none;color:var(--fg);font:1rem/1.3 var(--font-body);cursor:pointer}
.tfr-tool .list li button small{color:var(--muted);font:.8rem/1.3 var(--sans);font-variant-numeric:tabular-nums;white-space:nowrap}
.tfr-tool .list li button[aria-current="true"]{background:var(--highlight)}
.tfr-tool .entry h2{font:500 1.6rem/1.2 var(--font-display);margin:0 0 .2rem;text-wrap:balance}
.tfr-tool .entry .count{color:var(--muted);margin:0 0 1rem}
.tfr-tool .rows{list-style:none;margin:0;padding:0}
.tfr-tool .rows li{padding:.55rem 0;border-bottom:1px solid var(--border)}
.tfr-tool .rows .vol{font:500 1rem/1.3 var(--font-display)}
.tfr-tool .rows .subs{margin:.15rem 0 0;color:var(--muted);font-size:.8rem}
.tfr-tool .rows .subs a{color:var(--fg)}
.tfr-tool .more{margin:1rem 0 0;border:1px solid var(--border);background:var(--card-bg);color:var(--fg);padding:.45rem .9rem;border-radius:3px;font:600 .8rem/1 var(--sans);cursor:pointer}
.tfr-tool .verse{margin:1rem 0 .2rem;font:500 1rem/1.3 var(--font-display)}
.tfr-tool .muted{color:var(--muted)}
.tfr-tool .dir{list-style:none;margin:0;padding:0;border-top:1px solid var(--border)}
.tfr-tool .dir li{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.2rem 1rem;padding:.6rem 0;border-bottom:1px solid var(--border)}
.tfr-tool .dir a{font:500 1.25rem/1.3 var(--font-display)}
.tfr-tool .dir .who{color:var(--muted);font-size:.8rem;flex:1 1 100%}
.tfr-tool .dir small{color:var(--muted);font:.8rem/1.3 var(--sans);font-variant-numeric:tabular-nums;white-space:nowrap}
@media (max-width:720px){.tfr-tool .cols{grid-template-columns:1fr}
.tfr-tool .list{max-height:40vh}
.tfr-tool h1{font-size:1.6rem}}
.tfr-tool{background:transparent}
.tfr-tool .wrap{padding-top:1.2rem}
/* THE PAGE PREVIEW (2026-10-22, owner: "make it easy to preview things in the controversies, indices, etc"): a page reference's
   Preview opens the page itself under its row, in the page window (page-window.js; its look is work-hub.css). The same block on the
   controversies, the maps, the atlas, the shared questions and the set indexes. Here the cited page is named in its head rather than
   marked by a stripe, every page reads at full strength, the passage is marked in a tint of the ink, and Both stacks the two texts
   when the column is narrow (a side's preview sits in its side). */
.tfr-tool .pgs{display:inline-flex;flex:none;align-items:baseline;white-space:nowrap}
.tfr-tool .pvb{position:relative;display:inline-flex;align-items:center;margin-left:.45rem;padding:.1rem .55rem;border:1px solid var(--border);border-radius:999px;background:var(--card-bg);color:var(--fg);font:600 .8rem/1.2 var(--sans,var(--font-body));text-decoration:none;white-space:nowrap;cursor:pointer}
.tfr-tool .pvb:hover{border-color:var(--fg)}
.tfr-tool .pvb[aria-expanded="true"]{background:var(--fg);border-color:var(--fg);color:var(--bg)}
.tfr-tool a.pvl[aria-expanded="true"]{background:var(--fg);color:var(--bg);text-decoration:none;border-radius:2px;box-shadow:0 0 0 2px var(--fg)}
.tfr-tool .pvb:focus-visible,.tfr-tool .pvl:focus-visible,.tfr-tool .pvw :is(a,button):focus-visible{outline:2px solid var(--fg);outline-offset:2px}
@media (pointer:coarse){.tfr-tool .pvb::after{content:"";position:absolute;inset:-.55rem -.2rem}}
.tfr-tool .pvw{grid-column:1/-1;flex:1 0 100%;margin:.6rem 0 .8rem;border:1px solid var(--border);border-radius:6px;background:var(--card-bg);overflow:hidden;container-type:inline-size;text-align:left;white-space:normal;font-style:normal;font-size:1rem;--accent:var(--fg);--accent-soft:color-mix(in srgb,var(--fg) 20%,var(--card-bg));--body:var(--font-body)}
.tfr-tool .pvw-head{display:flex;flex-wrap:wrap;align-items:center;gap:.1rem 1rem;padding:.2rem .75rem;background:var(--bg);font:.8rem/1.3 var(--font-body)}
.tfr-tool .pvw-at{margin-right:auto;font-weight:600;font-variant-numeric:tabular-nums}
.tfr-tool .pvw-head a,.tfr-tool .pvw-x{display:inline-flex;align-items:center;min-height:2rem;padding:0;border:0;background:none;color:var(--fg);font:inherit;text-decoration:underline;text-underline-offset:3px;cursor:pointer}
.tfr-tool .pvw-pp{display:flex;flex-wrap:wrap;gap:.25rem}
@container (max-width:30rem){.tfr-tool .pvw-pp{order:3;flex-basis:100%;padding-bottom:.3rem}}
.tfr-tool .pvw-pp button{min-width:2rem;min-height:1.75rem;padding:0 .45rem;border:1px solid var(--border);border-radius:4px;background:var(--card-bg);color:var(--fg);font:inherit;font-variant-numeric:tabular-nums;cursor:pointer}
.tfr-tool .pvw-pp button[aria-pressed="true"]{background:var(--fg);border-color:var(--fg);color:var(--bg)}
.tfr-tool .pvw .pw-page h4{display:block;margin:0 0 6px;padding:0;border:0;font:600 .8rem/1.3 var(--body);letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.tfr-tool .pvw .pw-col h5{margin:.4em 0 .6em;padding:0;border:0;font:600 1rem/1.4 var(--body);text-align:center;text-wrap:balance;color:var(--fg)}
.tfr-tool .pvw .pw-col p{margin:0 0 .7em;max-width:70ch;font:1rem/1.65 var(--body);color:var(--fg);white-space:pre-line}
.tfr-tool .pvw .pw-col p:last-child{margin-bottom:0}
.tfr-tool .pvw .pw-col .pw-none{color:var(--muted);font-style:italic;font-size:.8rem}
.tfr-tool .pvw .pw-cited{border-left:0;padding-left:0;margin-left:0}
.tfr-tool .pvw .pw-page:not(.pw-cited){opacity:1}
.tfr-tool .pvw .pw-wait a{color:var(--fg)}
@container (max-width:36rem){.tfr-tool .pvw .pw-two{grid-template-columns:minmax(0,1fr);gap:.8rem}}
@media (prefers-reduced-motion:no-preference){.tfr-tool .pvw{animation:pvw-in .18s cubic-bezier(.22,1,.36,1)}}
@keyframes pvw-in{from{opacity:0;transform:translateY(-3px)}}
/* an index's page number opens its page here: the number is the button (and still the reader's link) */
.tfr-tool .rows .subs a.pvl{padding:0 .1rem;text-underline-offset:3px}
.tfr-tool .rows .subs a.pvl[aria-expanded="true"]{color:var(--bg)}
/* a part the page hides stays hidden, whatever its display (the directory hides the index's tabs, find box, letters and columns) */
.tfr-tool [hidden]{display:none!important}
/* the directory: a find box and the kinds and traditions, wrapping on a phone; the count of the sets shown */
.tfr-tool .dfind{display:block;width:100%;max-width:36rem;margin:0 0 .7rem;padding:.6rem .8rem;border:1px solid var(--border);border-radius:8px;background:var(--card-bg);color:var(--fg);font:1rem/1.3 var(--font-body)}
.tfr-tool .dfind::placeholder{color:var(--muted)}
.tfr-tool .dfind:focus-visible,.tfr-tool .dir a:focus-visible,.tfr-tool .subs a:focus-visible{outline:2px solid var(--fg);outline-offset:2px}
.tfr-tool .dirtools .chips{margin:0 0 .5rem}
.tfr-tool .chips button small{margin-left:.35rem;color:var(--muted);font:.8rem/1 var(--sans);font-variant-numeric:tabular-nums}
.tfr-tool .chips button[aria-pressed="true"] small{color:inherit}
.tfr-tool .dstat{margin:.5rem 0 .6rem;color:var(--muted);font:.8rem/1.4 var(--sans);font-variant-numeric:tabular-nums}
.tfr-tool .dir .muted button{margin-left:.5rem}
@media (pointer:coarse){.tfr-tool .dirtools .chips button{min-height:36px}}
</style>
{{/contentFor}}
{{!-- /the-faith-received/set-index/ — Index of the set, as The Faith Received has it (tools/prdl_reader_prototype/setindex.html), in this site's
     shell: the hero is the theme's, the body and its script (faith-set-index.js) the library's, reading the library worker. --}}
<section class="bhero bhero--tool">
  <div class="bhero-inner container">
    <p class="bhero-kicker"><a href="/the-faith-received/">The Faith Received</a> <span aria-hidden="true">&middot;</span> Index of the set</p>
    <h1 class="bhero-title" id="title">Index of the set</h1>
    
  </div>
</section>
<script src="{{asset "js/page/faith-tfr-rail.js"}}" defer></script>
<main class="tfr-tool"><div class="wrap">
  <p class="by" id="by">Loading…</p>
  <div class="tabs" role="tablist" aria-label="Index" id="tabs"></div>
  <form class="find" role="search" id="find"><label for="q" style="position:absolute;left:-9999px">Find in the index</label><input id="q" type="search" autocomplete="off"></form>
  <div class="letters" id="letters" role="group" aria-label="Browse by letter"></div>
  <div class="cols" id="cols"><ul class="list" id="list" aria-label="Entries"></ul><article class="entry" id="entry" aria-live="polite"></article></div>
  <div class="dirtools" id="dirtools" hidden>
    <input class="dfind" id="dfind" type="search" autocomplete="off" placeholder="Find a set: Luther, Migne, Suárez" aria-label="Find a set by its title, author or id">
    <div class="chips" id="dkinds" role="group" aria-label="Kind of set"></div>
    <div class="chips" id="dtrads" role="group" aria-label="Tradition, by the set's shelf or its author's"></div>
    <p class="dstat" id="dstat" role="status"></p>
  </div>
  <ul class="dir" id="dir" hidden aria-label="Sets with an index"></ul>

</div></main>
<link rel="stylesheet" href="{{asset "css/port/work-hub.css"}}&amp;frv=0374a552e8452478"><script src="{{asset "js/port/page-window.js"}}&amp;frv=2023bacb69cf7ee4"></script>
<script src="{{asset "js/faith-set-index.js"}}&amp;frv=ab5958b793668654"></script>
